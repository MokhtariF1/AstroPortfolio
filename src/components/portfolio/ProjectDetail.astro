---
import type { CollectionEntry } from "astro:content";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import Layout from "@/layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { getPortfolioConfig } from "@/data/portfolio";
import config from "@/config";

const { project, Content } = Astro.props as {
  project: CollectionEntry<"projects">;
  Content: AstroComponentFactory;
};
const site = getPortfolioConfig();
const canonicalURL = `https://hosseinmokhtari.ir/projects/${project.id}/`;
const projectSchema = {
  "@context": "https://schema.org",
  "@type": project.data.schemaType,
  "@id": `${canonicalURL}#project`,
  name: project.data.title,
  description: project.data.description,
  url: canonicalURL,
  inLanguage: "fa-IR",
  author: { "@id": "https://hosseinmokhtari.ir/about/#person" },
  ...(project.data.schemaType === "SoftwareSourceCode"
    ? { programmingLanguage: project.data.stack }
    : {}),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "خانه",
      item: "https://hosseinmokhtari.ir/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "پروژه‌ها",
      item: "https://hosseinmokhtari.ir/#projects",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: project.data.title,
      item: canonicalURL,
    },
  ],
};
---

<Layout
  title={`${project.data.seoTitle} | ${site.name}`}
  description={project.data.description}
  ogImage={`/og/projects/${project.id}.svg`}
  ogImageAlt={`تصویر معرفی پروژه ${project.data.title}`}
  canonicalURL={canonicalURL}
  jsonLd={[projectSchema, breadcrumbSchema]}
>
  <div class="portfolio-page">
    <Header />
    <main id="main-content" data-pagefind-body>
      <section
        class="relative isolate overflow-hidden bg-white px-8 pt-28 pb-16 sm:px-12 md:px-24 md:pt-40 md:pb-24 dark:bg-slate-950"
      >
        <div
          class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,#e5e7eb_1px,transparent_1px),linear-gradient(to_bottom,#e5e7eb_1px,transparent_1px)] bg-[size:200px_200px] opacity-50 dark:opacity-10"
        >
        </div>
        <div class="mx-auto max-w-7xl">
          <a
            href="/#projects"
            class="text-sm text-gray-600 underline decoration-dashed underline-offset-4 dark:text-gray-300"
            >← بازگشت به پروژه‌ها</a
          >
          <p class="mt-12 font-mono text-sm" style="color:var(--accent)">
            {project.data.category}
          </p>
          <h1
            class="mt-3 max-w-5xl text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl lg:text-7xl dark:text-gray-100"
          >
            {project.data.title}
          </h1>
          <p
            class="mt-8 max-w-4xl text-lg leading-relaxed text-gray-600 sm:text-2xl dark:text-gray-300"
          >
            {project.data.description}
          </p>
          <div class="mt-8 flex flex-wrap gap-2">
            {
              project.data.stack.map(skill => (
                <span class="rounded-lg bg-gray-900 px-3 py-1.5 text-sm font-medium text-white dark:bg-gray-100 dark:text-gray-900">
                  {skill}
                </span>
              ))
            }
          </div>
        </div>
      </section>
      <article class="app-prose mx-auto max-w-4xl px-8 py-16 sm:px-12 md:py-24">
        <Content />
        {
          config.features.blog && project.data.relatedPosts.length > 0 && (
            <aside aria-labelledby="related-posts-title">
              <h2 id="related-posts-title">مطالعه بیشتر درباره معماری پروژه</h2>
              <ul>
                {project.data.relatedPosts.map(post => (
                  <li>
                    <a href={post.href}>{post.title}</a>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }
      </article>
    </main>
    <Footer />
  </div>
</Layout>
