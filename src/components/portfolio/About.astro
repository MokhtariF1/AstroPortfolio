---
import { getPortfolioConfig } from "@/data/portfolio";
const siteConfig = getPortfolioConfig();
---

<section id="about" class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div>
    <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <h2
          class="text-3xl font-bold text-gray-900 sm:text-4xl md:text-5xl xl:text-7xl"
        >
          {siteConfig.aboutTitle}
        </h2>
        <div
          class="mt-2 h-[5px] w-[75px] rounded-full"
          style="background-color: var(--accent)"
        >
        </div>
      </div>

      <div class="space-y-8 lg:col-span-8">
        <p class="text-lg leading-relaxed text-gray-600 sm:text-xl md:text-2xl">
          {siteConfig.aboutMe}
        </p>
        <p class="text-base leading-relaxed text-gray-600 sm:text-lg">
          نام من در منابع انگلیسی به‌صورت <bdi lang="en">Hossein Mokhtari</bdi>
          نوشته می‌شود. برای آشنایی دقیق‌تر با مسیر کاری و شیوه‌ای که پروژه‌ها را
          پیش می‌برم، صفحه <a
            href="/about/"
            class="text-accent underline decoration-dashed underline-offset-4"
            >درباره حسین مختاری</a
          > را بخوانید.
        </p>

        <div class="pt-4">
          <div class="flex flex-wrap gap-3">
            {
              siteConfig.skills.map(skill => (
                <span class="rounded-full bg-gray-100 px-3 py-1.5 text-sm font-medium text-gray-800 transition-colors duration-200 hover:bg-gray-200 sm:px-4 sm:py-2 sm:text-base md:text-lg">
                  {skill}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
