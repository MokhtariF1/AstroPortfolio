---
import type { PortfolioLanguage } from "@/data/portfolio";
import { getPortfolioConfig } from "@/data/portfolio";
const { lang = "fa" } = Astro.props as { lang?: PortfolioLanguage };
const siteConfig = getPortfolioConfig(lang);
const prefix = lang === "en" ? "/en" : "";
---

<footer class="relative border-t border-gray-200 bg-gray-50 dark:border-slate-800 dark:bg-slate-950">
  <div class="mx-auto max-w-6xl px-6 py-12 lg:px-8">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <div class="flex flex-col gap-4">
        <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">{siteConfig.name}</h3>
        <p class="text-base text-gray-600 dark:text-gray-300">{siteConfig.title}</p>
        <div class="flex gap-x-6">
          <a href={`mailto:${siteConfig.social.email}`} aria-label="Email" class="text-gray-600 transition-colors duration-300 hover:text-accent dark:text-gray-300">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-6"><path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z"/><path d="m3 7 9 6 9-6"/></svg>
          </a>
          <a href={siteConfig.social.telegram} target="_blank" rel="noopener noreferrer" aria-label="Telegram" class="text-gray-600 transition-colors duration-300 hover:text-accent dark:text-gray-300">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-6"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
          </a>
          <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-gray-600 transition-colors duration-300 hover:text-accent dark:text-gray-300">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-6"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/></svg>
          </a>
        </div>
      </div>
      <div class="hidden flex-col gap-4 md:flex md:items-end">
        <nav class="flex gap-x-8">
          <a href={`${prefix}/#about`} class="text-sm text-gray-600 transition-colors hover:text-gray-800 dark:text-gray-300 dark:hover:text-white">{siteConfig.nav.about}</a>
          <a href={`${prefix}/#projects`} class="text-sm text-gray-600 transition-colors hover:text-gray-800 dark:text-gray-300 dark:hover:text-white">{siteConfig.nav.projects}</a>
          <a href="/posts/" class="text-sm text-gray-600 transition-colors hover:text-gray-800 dark:text-gray-300 dark:hover:text-white">{siteConfig.nav.blog}</a>
        </nav>
        <p class="text-sm text-gray-500 dark:text-gray-400">© {new Date().getFullYear()} {siteConfig.name}. {lang === "fa" ? "تمام حقوق محفوظ است." : "All rights reserved."}</p>
      </div>
    </div>
  </div>
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <svg aria-hidden="true" class="absolute bottom-0 left-0 h-24 w-full text-gray-100 dark:text-slate-900"><pattern id="footer-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse"><path d="M0 50 Q 25 40, 50 50 T 100 50" stroke="currentColor" stroke-width="0.5" fill="none" opacity="0.4"/></pattern><rect width="100%" height="100%" fill="url(#footer-pattern)"/></svg>
  </div>
</footer>
