---
import { getPortfolioConfig } from "@/data/portfolio";
import { getCollection } from "astro:content";
const siteConfig = getPortfolioConfig();
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
const hasProjects = projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <h2 class="text-3xl font-bold text-gray-900 sm:text-4xl md:text-5xl xl:text-7xl">
              {siteConfig.projectsTitle}
            </h2>
            <div
              class="mt-2 h-[5px] w-[75px] rounded-full"
              style="background-color: var(--accent)"
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-8">
              {projects.map((project, index) => {
                return (
                  <div class="group relative">
                    <a
                      href={`/projects/${project.id}/`}
                      class={`relative block rounded-xl border border-gray-200 bg-gray-50 p-4 transition-all duration-300 sm:rounded-2xl sm:p-6 md:p-8 ${"hover:-translate-y-1 hover:border-gray-300 hover:bg-white hover:shadow-xl"}`}
                    >
                      <div class="absolute end-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-gray-900 text-white transition-all duration-300 group-hover:bg-gray-700 sm:end-6 sm:top-6 sm:h-11 sm:w-11 md:end-8 md:top-8 md:h-12 md:w-12">
                        <svg
                          class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 sm:h-4.5 sm:w-4.5 md:h-5 md:w-5"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M7 17L17 7M17 7H7M17 7V17"
                          />
                        </svg>
                      </div>

                      <div class="space-y-4">
                        <div>
                          <span
                            class="font-mono text-sm"
                            style="color: var(--accent)"
                          >
                            0{index + 1}
                          </span>
                          <h3 class="mt-1 text-xl font-bold text-gray-900 sm:text-2xl">
                            {project.data.title}
                          </h3>
                        </div>

                        <p class="pe-12 text-base leading-relaxed text-gray-600 sm:pe-14 sm:text-lg md:pe-16">
                          {project.data.description}
                        </p>

                        {project.data.stack.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 pt-2 sm:gap-2">
                            {project.data.stack.map(skill => (
                              <span class="rounded-md bg-gray-900 px-2.5 py-1 text-xs font-medium text-white transition-all duration-300 group-hover:bg-gray-800 sm:rounded-lg sm:px-3 sm:py-1.5 sm:text-sm">
                                {skill}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                    </a>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
