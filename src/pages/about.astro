---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
const person = {
  "@type": "Person",
  "@id": "https://hosseinmokhtari.ir/about/#person",
  name: "حسین مختاری",
  alternateName: "Hossein Mokhtari",
  url: "https://hosseinmokhtari.ir/about/",
  jobTitle: "برنامه‌نویس بک‌اند، Python و سیستم‌های هوش مصنوعی",
  knowsAbout: [
    "Python",
    "FastAPI",
    "Laravel",
    "PostgreSQL",
    "اتوماسیون",
    "Crawler",
    "سیستم‌های هوش مصنوعی",
  ],
  sameAs: ["https://github.com/MokhtariF1", "https://t.me/Ho3einMokhtari"],
};
const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://hosseinmokhtari.ir/about/#profile",
  url: "https://hosseinmokhtari.ir/about/",
  name: about.data.title,
  inLanguage: "fa-IR",
  mainEntity: person,
};
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
  pageType="profile"
  jsonLd={profileSchema}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={about.data.title} class="app-prose">
    <Content />
  </Main>

  <Footer />
</Layout>
