---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/portfolio/Header.astro";
import Hero from "@/components/portfolio/Hero.astro";
import About from "@/components/portfolio/About.astro";
import Projects from "@/components/portfolio/Projects.astro";
import Footer from "@/components/portfolio/Footer.astro";
import { getPortfolioConfig } from "@/data/portfolio";

const site = getPortfolioConfig();
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://hosseinmokhtari.ir/about/#person",
  name: site.name,
  alternateName: "Hossein Mokhtari",
  url: "https://hosseinmokhtari.ir/about/",
  jobTitle: "برنامه‌نویس بک‌اند، Python و سیستم‌های هوش مصنوعی",
  sameAs: [site.social.github, site.social.telegram],
  knowsAbout: site.skills,
};
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://hosseinmokhtari.ir/#website",
  url: "https://hosseinmokhtari.ir/",
  name: "حسین مختاری",
  alternateName: "Hossein Mokhtari",
  inLanguage: "fa-IR",
  creator: { "@id": "https://hosseinmokhtari.ir/about/#person" },
};
---

<Layout
  dir="rtl"
  title={`${site.name} | ${site.title}`}
  description={site.description}
  canonicalURL="https://hosseinmokhtari.ir/"
  ogImageAlt="حسین مختاری، برنامه‌نویس بک‌اند و Python"
  jsonLd={[websiteSchema, personSchema]}
>
  <div class="portfolio-page">
    <Header />
    <main id="main-content" data-pagefind-body>
      <Hero />
      <About />
      <Projects />
    </main>
    <Footer />
  </div>
</Layout>
