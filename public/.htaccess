Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^posts/ساخت-crawler-قابل-resume-python/?$ /posts/resumable-python-crawler/ [R=301,L,NE]
  RewriteRule ^posts/شروع-وبلاگ-حسین-مختاری/?$ /posts/welcome-to-hossein-mokhtari-blog/ [R=301,L,NE]
  RewriteRule ^posts/طراحی-importer-idempotent-postgresql/?$ /posts/idempotent-postgresql-importer/ [R=301,L,NE]
  RewriteRule ^posts/طراحی-ledger-رزرو-بودجه-laravel/?$ /posts/laravel-ledger-budget-reservation/ [R=301,L,NE]
  RewriteRule ^posts/طراحی-state-machine-دستیار-هوشمند-فارسی/?$ /posts/persian-ai-assistant-state-machine/ [R=301,L,NE]
  RewriteRule ^en/?$ / [R=301,L,NE]
  RewriteRule ^en/(.*)$ /$1 [R=301,L,NE]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.hosseinmokhtari\.ir$ [NC]
  RewriteRule ^ https://hosseinmokhtari.ir%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(css|js|woff2|svg|png|jpg|jpeg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

ErrorDocument 404 /404.html
